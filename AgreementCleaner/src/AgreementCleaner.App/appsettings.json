{
  // Folder that holds the SQL scripts. Use a shared network folder so that
  // updating a script there updates it for every user straight away.
  // A relative path (for example "SqlScripts") is resolved against the .exe folder.
  "ScriptFolder": "\\\\your-file-server\\Shared\\AgreementCleaner\\SqlScripts",

  // Maximum time, in seconds, that one script may run.
  "CommandTimeoutSeconds": 300,

  // File names inside ScriptFolder. Change these only if you rename a file.
  "Scripts": {
    "FindAgreement": "FindAgreement.sql",
    "DeleteGateway": "DeleteGateway.sql",
    "DeleteDrms": "DeleteDRMS.sql",
    "ClearComms": "ClearCommsData.sql"
  },

  // Only DEV and TEST are allowed. Names containing PROD or LIVE are refused.
  "Environments": [
    {
      "Name": "DEV",
      "DrmsConnectionString": "Server=dev-sql-server;Database=DRMS;Integrated Security=True;TrustServerCertificate=True",
      "GatewayConnectionString": "Server=dev-sql-server;Database=SubscriptionGateway;Integrated Security=True;TrustServerCertificate=True",
      "CommsConnectionString": "Server=dev-sql-server;Database=Comms;Integrated Security=True;TrustServerCertificate=True"
    },
    {
      "Name": "TEST",
      "DrmsConnectionString": "Server=test-sql-server;Database=DRMS;Integrated Security=True;TrustServerCertificate=True",
      "GatewayConnectionString": "Server=test-sql-server;Database=SubscriptionGateway;Integrated Security=True;TrustServerCertificate=True",
      "CommsConnectionString": "Server=test-sql-server;Database=Comms;Integrated Security=True;TrustServerCertificate=True"
    }
  ]
}
